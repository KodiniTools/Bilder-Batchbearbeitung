{
  "name": "bilderserie-bearbeiten",
  "version": "1.0.0",
  "description": "Batch-Bildbearbeitung Desktop App - Bilder bearbeiten, konvertieren und exportieren",
  "author": "KodiniTools",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.js",
    "lint:fix": "eslint . --ext .vue,.ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:electron": "vite build --config vite.config.electron.ts",
    "dist:win": "npm run build:electron && electron-builder --win"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "terser": "^5.44.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^1.8.27"
  },
  "build": {
    "appId": "com.kodinitools.bilderserie-bearbeiten",
    "productName": "Bilderserie Bearbeiten",
    "copyright": "Copyright © 2024–2025 KodiniTools",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/icon.png"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "fileAssociations": [
        {
          "ext": ["jpg", "jpeg"],
          "name": "JPEG Image",
          "description": "JPEG Bilddatei",
          "role": "Viewer"
        },
        {
          "ext": ["png"],
          "name": "PNG Image",
          "description": "PNG Bilddatei",
          "role": "Viewer"
        },
        {
          "ext": ["webp"],
          "name": "WebP Image",
          "description": "WebP Bilddatei",
          "role": "Viewer"
        },
        {
          "ext": ["gif"],
          "name": "GIF Image",
          "description": "GIF Bilddatei",
          "role": "Viewer"
        },
        {
          "ext": ["bmp"],
          "name": "BMP Image",
          "description": "BMP Bilddatei",
          "role": "Viewer"
        }
      ]
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bilderserie Bearbeiten",
      "runAfterFinish": true,
      "installerLanguages": ["de_DE", "en_US"],
      "language": "1031",
      "menuCategory": "KodiniTools",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "compression": "maximum"
  }
}
