{
  "name": "bilderserie-bearbeiten",
  "version": "1.0.0",
  "description": "Batch-Bildbearbeitung Desktop App - Bilder bearbeiten, konvertieren und exportieren",
  "author": "KodiniTools",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "build:electron": "vite build --config vite.config.electron.ts",
    "dist:win": "npm run build:electron && electron-builder --win"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "i18next": "^25.6.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "terser": "^5.44.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.27"
  },
  "build": {
    "appId": "com.kodinitools.bilderserie-bearbeiten",
    "productName": "Bilderserie Bearbeiten",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bilderserie Bearbeiten"
    }
  }
}
